# Copy to infra/.env and adjust as needed. Never commit infra/.env.
# These vars configure the local Postgres (docker-compose) and the
# ingest/export Python scripts (which read the same names from the environment).

POSTGRES_USER=iluc
# Set your own local password (any value) before `make db-up`. Never commit it.
POSTGRES_PASSWORD=
POSTGRES_DB=iluc_nipe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Adminer UI port (http://localhost:8080).
ADMINER_PORT=8080
